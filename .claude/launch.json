{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "n1ko-music-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mock-subsonic",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mock-subsonic.mjs"
      ],
      "port": 4533,
      "autoPort": true
    },
    {
      "name": "n1ko-music-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite preview --port 4173"
      ],
      "port": 4173
    }
  ]
}
