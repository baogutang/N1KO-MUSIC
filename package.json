{
  "name": "n1ko-music",
  "productName": "N1KO MUSIC",
  "private": true,
  "version": "1.16.1",
  "description": "N1KO MUSIC - The best NAS music player",
  "author": "N1KO",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "check:versions": "node scripts/check-app-versions.mjs",
    "lint:plugins": "frontend/node_modules/.bin/eslint --no-eslintrc -c eslint.plugins.config.cjs \"plugins/**/*.js\" \"scripts/*.mjs\"",
    "check:plugin-versions": "node scripts/check-plugin-versions.mjs",
    "audit:check": "node scripts/audit-allowlist.mjs",
    "test:plugins": "node --test \"plugins/test/*.test.mjs\"",
    "tauri:dev": "cd frontend && npm run tauri dev",
    "tauri:build": "cd frontend && npm run tauri build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
